# Enrutamiento al controlador frontal
Options -Indexes
DirectoryIndex index.php

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Forzar HTTPS (la cámara del kiosco lo exige).
  # Quita los # de las 4 líneas siguientes cuando el SSL ya esté activo en InfinityFree.
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Bloquear carpetas privadas si se subieron dentro de htdocs
  RewriteRule ^(app|storage|database|tests)(/|$) - [F,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "^\.|\.(sql|md|log|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
